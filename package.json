{
  "name": "smoldoc",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "build": "pnpm --filter @smoldoc/server build",
    "dev:mcp": "pnpm --filter @smoldoc/server dev:mcp",
    "dev:worker": "pnpm --filter @smoldoc/server dev:worker",
    "start:mcp": "pnpm --filter @smoldoc/server start:mcp",
    "start:worker": "pnpm --filter @smoldoc/server start:worker",
    "typecheck": "pnpm --filter @smoldoc/server typecheck"
  }
}
