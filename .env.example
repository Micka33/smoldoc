# OpenAI API key (also accepts OPENAPI_API_KEY for backwards compatibility)
OPENAI_API_KEY=
# OPENAPI_API_KEY=

# Infra (docker-compose defaults)
DATABASE_URL=postgresql://smoldoc:smoldoc@localhost:5432/smoldoc
REDIS_URL=redis://127.0.0.1:6379

# Model (must support reasoning_effort on your account)
SMOLDOC_OPENAI_MODEL=gpt-5.5
SMOLDOC_REASONING_EFFORT=high

# Optional: comma-separated hostnames allowed for HTTP fetches (empty = allow all public http(s))
# SMOLDOC_ALLOWED_HOSTS=example.com,docs.example.com

# Where cached markdown pages are stored on disk
SMOLDOC_PAGE_CACHE_DIR=.data/pages
