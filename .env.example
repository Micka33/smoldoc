# MCP server (Postgres + Redis only)
DATABASE_URL=postgresql://smoldoc:smoldoc@localhost:5432/smoldoc
REDIS_URL=redis://127.0.0.1:6379

# Worker: Pi SDK uses OpenAI (setRuntimeApiKey). Required on the worker process.
OPENAI_API_KEY=
# OPENAPI_API_KEY=

# Pi SDK (https://pi.dev/docs/latest/sdk)
SMOLDOC_PI_CWD=/absolute/path/to/repo
# Isolated Pi config + auth.json parent (default: OS temp /smoldoc-pi-agent)
# SMOLDOC_PI_AGENT_DIR=/var/lib/smoldoc/pi-agent

# OpenAI model id as registered in Pi (default gpt-5.5). Prefix openai/ optional.
SMOLDOC_PI_MODEL=gpt-5.5

# Pi thinking level: off | minimal | low | medium | high | xhigh
SMOLDOC_PI_THINKING=high

# Optional: comma-separated hostnames for future native tools
# SMOLDOC_ALLOWED_HOSTS=example.com,docs.example.com

SMOLDOC_PAGE_CACHE_DIR=.data/pages
