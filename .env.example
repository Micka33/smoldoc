# Infra (docker-compose defaults)
DATABASE_URL=postgresql://smoldoc:smoldoc@localhost:5432/smoldoc
REDIS_URL=redis://127.0.0.1:6379

# Worker: pi CLI (install: npm i -g @mariozechner/pi-coding-agent)
# smoldoc invokes `pi run` by default; Docker image ships a shim so `pi run` → `pi`.
SMOLDOC_PI_COMMAND=pi run
# Working directory for pi (AGENTS.md / .pi/ skills); use repo root
SMOLDOC_PI_CWD=/absolute/path/to/smoldoc
# Optional extra args after `pi run`, e.g. --extension ./smoldoc.pi.ts --skill foo
# SMOLDOC_PI_EXTRA_ARGS=--no-context-files

# Optional: pass through to pi (see pi --help)
# SMOLDOC_PI_PROVIDER=openai
# SMOLDOC_PI_MODEL=openai/gpt-5.5
# SMOLDOC_PI_THINKING=high

# Pi needs its own provider keys in the environment (e.g. OPENAI_API_KEY, ANTHROPIC_API_KEY)

# Optional: comma-separated hostnames for future smoldoc-native tools (pi uses bash/curl today)
# SMOLDOC_ALLOWED_HOSTS=example.com,docs.example.com

# Where on-disk snapshots would go if re-enabled
SMOLDOC_PAGE_CACHE_DIR=.data/pages
