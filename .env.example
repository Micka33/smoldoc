# MCP + worker
DATABASE_URL=postgresql://smoldoc:smoldoc@localhost:5432/smoldoc
REDIS_URL=redis://127.0.0.1:6379

# Worker only — Pi + OpenAI embeddings
OPENAI_API_KEY=
# OPENAPI_API_KEY=

# Pi session cwd MUST contain .pi/skills (use packages/server after clone)
SMOLDOC_PI_CWD=/absolute/path/to/repo/packages/server

# Compiled Layer A/B scripts (default: <cwd>/dist/scripts when worker cwd is packages/server)
SMOLDOC_SCRIPTS_DIR=/absolute/path/to/repo/packages/server/dist/scripts

# Pi isolated config (auth.json)
# SMOLDOC_PI_AGENT_DIR=/var/lib/smoldoc/pi-agent

SMOLDOC_PI_MODEL=gpt-5.5
SMOLDOC_PI_THINKING=high

# SMOLDOC_ALLOWED_HOSTS=example.com,docs.example.com
SMOLDOC_PAGE_CACHE_DIR=.data/pages

# Optional: raw file cache for fetch-doc (default .data/smoldoc-raw-cache under cwd)
# SMOLDOC_RAW_CACHE_DIR=.data/smoldoc-raw-cache

# Headless browser (fetch-doc --browser)
# CHROMIUM_PATH=/usr/bin/chromium
